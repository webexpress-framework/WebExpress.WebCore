<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<Title>WebExpress.WebCore</Title>
		<Version>2.0.1-alpha</Version>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifiers>any</RuntimeIdentifiers>
		<RepositoryUrl>https://github.com/webexpress-framework/WebExpress.git</RepositoryUrl>
		<Authors>webexpress-framework@outlook.com</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Company>webexpress-framework@outlook.com</Company>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Core library of the WebExpress web server.</Description>
		<PackageProjectUrl>https://github.com/webexpress-framework/WebExpress</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<PackageTags>webexpress</PackageTags>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<IsPackable>true</IsPackable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Configurations>Debug;Release;DebugLocal</Configurations>
		<DisableImplicitStaticWebAssets>true</DisableImplicitStaticWebAssets>
	</PropertyGroup>

	<PropertyGroup>
		<!-- under Visual Studio the package would start its sbom-tool.exe, which requires the .NET 8 runtime; GenerateSbomWithDotnet hands the work to the dotnet msbuild instead -->
		<GenerateSbom Condition="'$(MSBuildRuntimeType)' == 'Core' AND '$(Configuration)' == 'Release'">true</GenerateSbom>
		<SbomGenerationPackageVersion>$(Version)</SbomGenerationPackageVersion>
		<!-- the component detection takes every *.nuspec it sees for a dependency, and obj keeps one per version ever packed; it scans a folder holding only the restore graph (see PrepareSbomComponents) -->
		<SbomGenerationBuildComponentPath>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)sbom-components</SbomGenerationBuildComponentPath>
	</PropertyGroup>

	<!-- downloaded rather than referenced: a package reference, even with PrivateAssets="all", lands in the restore graph, and the SBOM would list its own build tool as a dependency of the package -->
	<ItemGroup>
		<PackageDownload Include="Microsoft.Sbom.Targets" Version="[4.1.13]" />
	</ItemGroup>

	<Import Project="$(NuGetPackageRoot)microsoft.sbom.targets\4.1.13\build\Microsoft.Sbom.Targets.targets" Condition="Exists('$(NuGetPackageRoot)microsoft.sbom.targets\4.1.13\build\Microsoft.Sbom.Targets.targets')" />

	<ItemGroup>
		<PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
		<PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Internationalization\de" />
		<EmbeddedResource Include="Internationalization\en" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\icon.png">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="ufo.ico">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="WebPermissions\" />
	</ItemGroup>

	<Target Name="GenerateSbomWithDotnet" AfterTargets="Pack" Condition="'$(MSBuildRuntimeType)' != 'Core' AND '$(IsPackable)' == 'true' AND '$(Configuration)' == 'Release'">
		<Exec Command="dotnet msbuild &quot;$(MSBuildProjectFullPath)&quot; -nologo -v:m -t:GenerateSbomTarget -p:Configuration=$(Configuration)" />
	</Target>

	<Target Name="PrepareSbomComponents" BeforeTargets="GenerateSbomTarget" Condition="'$(GenerateSbom)' == 'true'">
		<PropertyGroup>
			<!-- the detection reports download dependencies too, which holds nothing but the SBOM tool; the array has flat objects only, so a pattern can empty it -->
			<SbomDownloadDependencies>"downloadDependencies":\s*\[[^{}\]]*(\{[^{}]*\}[^{}\]]*)*\]</SbomDownloadDependencies>
			<SbomRestoreGraph>$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)'))</SbomRestoreGraph>
			<SbomRestoreGraph>$([System.Text.RegularExpressions.Regex]::Replace('$(SbomRestoreGraph)', '$(SbomDownloadDependencies)', '"downloadDependencies": []'))</SbomRestoreGraph>
		</PropertyGroup>
		<RemoveDir Directories="$(SbomGenerationBuildComponentPath)" />
		<WriteLinesToFile File="$(SbomGenerationBuildComponentPath)\project.assets.json" Lines="$([MSBuild]::Escape('$(SbomRestoreGraph)'))" Overwrite="true" />
	</Target>

	<!-- Microsoft.Sbom.Targets only embeds the manifest in the nupkg; copy it next to the package as well -->
	<Target Name="CopySbomToPackageOutput" AfterTargets="GenerateSbomTarget" Condition="'$(IsPackable)' == 'true' AND '$(GenerateSbom)' == 'true'">
		<!-- set inside the target because PackageId and PackageOutputPath are only defined after the project file is evaluated -->
		<PropertyGroup>
			<SbomUnzipPath>$(IntermediateOutputPath)sbom</SbomUnzipPath>
			<SbomFileName>$(PackageId.ToLowerInvariant())</SbomFileName>
			<!-- dotnet pack -o sets PackageOutputPath without a trailing slash -->
			<SbomPackageDir>$([MSBuild]::EnsureTrailingSlash('$(PackageOutputPath)'))</SbomPackageDir>
		</PropertyGroup>
		<RemoveDir Directories="$(SbomUnzipPath)" />
		<Unzip SourceFiles="$(SbomPackageDir)$(PackageId).$(PackageVersion).nupkg" DestinationFolder="$(SbomUnzipPath)" />
		<ItemGroup>
			<SbomFile Include="$(SbomUnzipPath)\_manifest\$(SbomSpecification)\manifest.spdx.json" TargetPath="$(SbomPackageDir)$(SbomFileName).spdx.json" />
			<SbomFile Include="$(SbomUnzipPath)\_manifest\$(SbomSpecification)\manifest.spdx.json.sha256" TargetPath="$(SbomPackageDir)$(SbomFileName).spdx.json.sha256" />
		</ItemGroup>
		<Copy SourceFiles="@(SbomFile)" DestinationFiles="@(SbomFile->'%(TargetPath)')" />
		<RemoveDir Directories="$(SbomUnzipPath)" />
	</Target>

</Project>
